# Copia este archivo como .env y ajusta los valores a tu entorno.
# El archivo .env NO debe subirse al repositorio (ver .gitignore).

PORT=3000

# ---------------------------------------------------------------
# Base de datos MySQL / MariaDB
# ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=phonestore

# ---------------------------------------------------------------
# JWT (autenticación)
# Genera una clave larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------
JWT_SECRET=cambia_esta_clave_por_una_muy_segura_y_larga
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------
# Seguridad de la API
# ---------------------------------------------------------------
# Orígenes autorizados a consumir la API (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# URL pública del frontend (se usa en el enlace de recuperación de contraseña).
FRONTEND_URL=http://localhost:5173

# Minutos de validez del enlace para restablecer la contraseña.
RESET_TOKEN_TTL_MIN=30

# ---------------------------------------------------------------
# Correo saliente (OPCIONAL)
# Si se deja vacío, los correos de recuperación NO se envían por
# internet: quedan registrados en backend-fastapi/correos_enviados.log
# y en la consola del servidor, que es suficiente para desarrollo.
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------
# Usuario administrador inicial
# (lo usa solo app/scripts/seed_admin.py; la contraseña se hashea)
# ---------------------------------------------------------------
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=PhoneStore
ADMIN_EMAIL=admin@phonestore.com
ADMIN_PASSWORD=Admin1234
ADMIN_DOCUMENTO=1000000000
ADMIN_TELEFONO=3000000000
ADMIN_DIRECCION=Oficina principal calle 45

# ---------------------------------------------------------------
# Verificación de correo y segundo paso del inicio de sesión
# ---------------------------------------------------------------
# SMTP_TLS=0 sirve para servidores de prueba locales que no cifran.
SMTP_TLS=1
VERIFICACION_TOKEN_TTL_MIN=1440
DOBLE_FACTOR_TTL_MIN=10
DOBLE_FACTOR_MAX_INTENTOS=5

# Dominios que nunca reciben correo real (las pruebas usan direcciones
# inventadas: sin esto el proveedor devolveria un rebote por cada una).
SMTP_DOMINIOS_SIN_ENVIO=phonestore.com,example.com
